+    def test_none_replaces_existing_value(self):
+        result = patch_settings({"note": "before"}, {"note": None})
+        self.assertIsNone(result["note"])
+
+    def test_empty_text_replaces_existing_value(self):
+        result = patch_settings({"note": "before"}, {"note": ""})
+        self.assertEqual(result["note"], "")
+
+    def test_false_replaces_existing_value(self):
+        result = patch_settings({"enabled": True}, {"enabled": False})
+        self.assertIs(result["enabled"], False)
+
+    def test_omitted_keys_keep_current_values(self):
+        result = patch_settings({"note": "keep", "enabled": True}, {"enabled": False})
+        self.assertEqual(result, {"note": "keep", "enabled": False})
+
+    def test_clear_note_clears_the_note(self):
+        result = clear_note({"note": "before", "enabled": True})
+        self.assertEqual(result, {"note": None, "enabled": True})
+
+    def test_inputs_are_not_mutated(self):
+        current = {"note": "before", "enabled": True}
+        patch = {"enabled": False}
+        patch_settings(current, patch)
+        self.assertEqual(current, {"note": "before", "enabled": True})
