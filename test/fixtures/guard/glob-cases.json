{
  "_comment": "Glob matcher fixture table for klaude-plugin/scripts/guard/guard.py glob_to_regex. Built from the Claude Code permission docs' own examples. Placeholders: {root} = project root, {parent} = its parent directory, {home} = home directory. Every path is absolute and already normalised; the matcher is tested without symlink resolution. expect is match, nomatch, or reject (glob_to_regex must raise ValueError; path is ignored).",
  "cases": [
    { "pattern": "./**/.env", "path": "{root}/.env", "expect": "match", "note": "any depth includes the root itself" },
    { "pattern": "./**/.env", "path": "{root}/a/b/.env", "expect": "match", "note": "any depth" },
    { "pattern": "./**/.env", "path": "{parent}/.env", "expect": "nomatch", "note": "anchored at the project root, not its parent" },
    { "pattern": "./**/.env", "path": "{root}/.env.example", "expect": "nomatch", "note": "exact basename; dotenv example stays readable" },
    { "pattern": "./**/.env", "path": "{root}/.envrc", "expect": "nomatch", "note": "no partial basename match" },
    { "pattern": "./**/.env.*.local", "path": "{root}/.env.staging.local", "expect": "match", "note": "* within a segment" },
    { "pattern": "./**/.env.*.local", "path": "{root}/.env.local", "expect": "nomatch", "note": "needs the middle segment; .env.local has its own glob" },
    { "pattern": "./**/.env.local", "path": "{root}/apps/web/.env.local", "expect": "match", "note": "" },
    { "pattern": "./**/service-account*.json", "path": "{root}/infra/service-account-key.json", "expect": "match", "note": "prefix glob" },
    { "pattern": "./**/service-account*.json", "path": "{root}/infra/service-account.json", "expect": "match", "note": "* matches empty" },
    { "pattern": "./**/*.tfstate", "path": "{root}/env/prod/terraform.tfstate", "expect": "match", "note": "" },
    { "pattern": "./**/*.tfstate", "path": "{root}/env/prod/terraform.tfstate.backup", "expect": "nomatch", "note": "suffix is exact; .backup has its own glob" },
    { "pattern": "./**/*.pem", "path": "{root}/certs/cert.pem", "expect": "match", "note": "accepted false positive on public certs" },
    { "pattern": "./**/id_rsa", "path": "{root}/.ssh/id_rsa", "expect": "match", "note": "" },
    { "pattern": "./**/id_rsa", "path": "{root}/.ssh/id_rsa.pub", "expect": "nomatch", "note": "public key stays readable" },
    { "pattern": "./**/.terraform/**", "path": "{root}/infra/.terraform/providers/x", "expect": "match", "note": "anything beneath" },
    { "pattern": "./**/.terraform/**", "path": "{root}/infra/.terraform", "expect": "match", "note": "the directory itself (a Grep root)" },
    { "pattern": "./**/.terraform/**", "path": "{root}/infra/.terraformrc", "expect": "nomatch", "note": "" },
    { "pattern": "./src/*.go", "path": "{root}/src/main.go", "expect": "match", "note": "" },
    { "pattern": "./src/*.go", "path": "{root}/src/sub/main.go", "expect": "nomatch", "note": "* does not cross /" },
    { "pattern": "./src/**/*.go", "path": "{root}/src/sub/deep/main.go", "expect": "match", "note": "** crosses /" },
    { "pattern": "./src/**/*.go", "path": "{root}/src/main.go", "expect": "match", "note": "**/ may be empty" },
    { "pattern": "./file?.txt", "path": "{root}/file1.txt", "expect": "match", "note": "? is one character" },
    { "pattern": "./file?.txt", "path": "{root}/file12.txt", "expect": "nomatch", "note": "" },
    { "pattern": "./file?.txt", "path": "{root}/file.txt", "expect": "nomatch", "note": "? is exactly one character" },
    { "pattern": "./.env", "path": "{root}/.env", "expect": "match", "note": "./ exact path" },
    { "pattern": "./.env", "path": "{root}/sub/.env", "expect": "nomatch", "note": "./ with a name is exact, not any depth" },
    { "pattern": ".env", "path": "{root}/sub/deep/.env", "expect": "match", "note": "bare name equals **/.env (gitignore semantics)" },
    { "pattern": ".env", "path": "{root}/.env", "expect": "match", "note": "" },
    { "pattern": ".env", "path": "{parent}/.env", "expect": "nomatch", "note": "bare still anchors at the root" },
    { "pattern": ".git/", "path": "{root}/vendor/x/.git/config", "expect": "match", "note": "single-segment directory in deny position matches at any depth" },
    { "pattern": ".git/", "path": "{root}/.git", "expect": "match", "note": "the directory itself" },
    { "pattern": ".git/", "path": "{root}/.gitignore", "expect": "nomatch", "note": "" },
    { "pattern": "~/.ssh/**", "path": "{home}/.ssh/id_rsa", "expect": "match", "note": "" },
    { "pattern": "~/.ssh/**", "path": "{home}/.ssh", "expect": "match", "note": "a Grep rooted at the directory" },
    { "pattern": "~/.ssh/**", "path": "{home}/.sshx/id_rsa", "expect": "nomatch", "note": "segment boundary" },
    { "pattern": "~/.ssh/**", "path": "{root}/.ssh/id_rsa", "expect": "nomatch", "note": "home-anchored, not project-anchored" },
    { "pattern": "~/.netrc", "path": "{home}/.netrc", "expect": "match", "note": "" },
    { "pattern": "~/.netrc", "path": "{home}/sub/.netrc", "expect": "nomatch", "note": "~/<file> is exact, not any depth" },
    { "pattern": "~/.docker/config.json", "path": "{home}/.docker/config.json", "expect": "match", "note": "" },
    { "pattern": "~/.config/gcloud/**", "path": "{home}/.config/gcloud/credentials.db", "expect": "match", "note": "" },
    { "pattern": "//etc/**", "path": "/etc/passwd", "expect": "match", "note": "absolute anchor" },
    { "pattern": "//etc/**", "path": "/etcetera/x", "expect": "nomatch", "note": "" },
    { "pattern": "//etc/**", "path": "{root}/etc/passwd", "expect": "nomatch", "note": "absolute, not project-relative" },
    { "pattern": "//var/log/*.log", "path": "/var/log/syslog.log", "expect": "match", "note": "" },
    { "pattern": "~/.aws/**", "path": "{home}/.aws/cred\nentials", "expect": "match", "note": "a newline inside a filename must not escape a directory wildcard" },
    { "pattern": "~/.ssh/**", "path": "{home}/.ssh/id_rsa\n", "expect": "match", "note": "trailing newline is part of the name, still beneath the directory" },
    { "pattern": "/src/*.go", "path": "", "expect": "reject", "note": "single leading slash is ambiguous between harness layers; use // or ./" },
    { "pattern": "./**/[ab].env", "path": "", "expect": "reject", "note": "character classes are not implemented; refuse rather than treat as literals" },
    { "pattern": "!./**/.env", "path": "", "expect": "reject", "note": "leading ! is negation, out of scope" },
    { "pattern": "./**/secret!.json", "path": "{root}/a/secret!.json", "expect": "match", "note": "a literal ! inside a name is not negation" },
    { "pattern": "~.", "path": "{root}/x/~.", "expect": "match", "note": "only ~ and ~/ are the home anchor; ~. is a bare filename at any depth under the root" },
    { "pattern": "~backup/.env", "path": "{root}/~backup/.env", "expect": "match", "note": "~user forms are not expanded; treated as a literal project-relative path" },
    { "pattern": "./../shared/.env", "path": "", "expect": "reject", "note": ".. segment can never match a normalised path" },
    { "pattern": "./a//b", "path": "", "expect": "reject", "note": "empty segment can never match a normalised path" },
    { "pattern": "./**/./.env", "path": "", "expect": "reject", "note": ". segment can never match a normalised path" },
    { "pattern": "", "path": "", "expect": "reject", "note": "empty glob" }
  ]
}
