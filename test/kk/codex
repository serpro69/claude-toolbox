#!/usr/bin/env python3
"""Local plugin cache and hook inventory used by installer and launcher fixtures."""
import json
import os
from pathlib import Path
import re
import shutil
import sys

args = sys.argv[1:]
directory = Path(os.environ["CODEX_HOME"])
# kk checks candidate settings in a scratch CODEX_HOME; a test names the home whose controls apply there.
fixtures = Path(os.environ.get("KK_TEST_CODEX_FIXTURES") or directory)
market = directory / "fixture-market"
cache = directory / "plugins/cache/agentstakk-local"
STRING = r'"(?:[^"\\]|\\.)*"'
KEY = re.compile(STRING + r"|[A-Za-z0-9_-]+")
SCALAR = re.compile(STRING + r"|true|false|-?[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?")


def installed():
    return [{"pluginId": p.parent.name + "@agentstakk-local", "version": p.name, "enabled": True}
            for p in sorted(cache.glob("*/*")) if p.is_dir()]


def toml_value(text):
    """Read the values kk's toml_value emits; like Codex, keep anything else as a plain string."""
    def skip(at):
        while text[at:at + 1] == " ":
            at += 1
        return at

    def token(pattern, at):
        found = pattern.match(text, at)
        if not found:
            raise ValueError(text)
        bare = pattern is KEY and found[0][0] != '"'
        return found[0] if bare else json.loads(found[0]), skip(found.end())

    def read(at):
        at = skip(at)
        opener = text[at:at + 1]
        if opener not in ("{", "["):
            return token(SCALAR, at)
        value, closer = ({}, "}") if opener == "{" else ([], "]")
        at = skip(at + 1)
        while text[at:at + 1] != closer:
            if opener == "{":
                key, at = token(KEY, at)
                if text[at:at + 1] != "=":
                    raise ValueError(text)
                value[key], at = read(at + 1)
            else:
                item, at = read(at)
                value.append(item)
            if text[at:at + 1] == ",":
                at = skip(at + 1)
        return value, skip(at + 1)

    try:
        value, end = read(0)
        if end != len(text):
            raise ValueError(text)
    except ValueError:
        return text
    return value


def put(table, path, value):
    for part in path[:-1]:
        if not isinstance(table.get(part), dict):
            table[part] = {}
        table = table[part]
    table[path[-1]] = value


def session_flags(arguments):
    """Merge configuration flags the way Codex 0.172 builds its session layer.

    Each -c applies in order: a dotted path sets one leaf, splitting on every
    dot, and an inline table replaces everything under its key. Feature toggles
    apply after every -c, wherever they appear.
    """
    config, toggles = {}, []
    it = iter(arguments)
    for arg in it:
        key, separator, value = arg.partition("=")
        if arg[:2] == "-c" and len(arg) > 2:
            key, separator, value = "-c", "attached", arg[3:] if arg[2] == "=" else arg[2:]
        if key not in ("-c", "--config", "--enable", "--disable"):
            continue
        if not separator:
            value = next(it)
        if key in ("--enable", "--disable"):
            toggles.append((["features", value], key == "--enable"))
        else:
            path, _, value = value.partition("=")
            put(config, path.split("."), toml_value(value))
    for path, value in toggles:
        put(config, path, value)
    return config


def leaves(table, path=()):
    for key, value in table.items():
        if isinstance(value, dict) and value:
            yield from leaves(value, path + (key,))
        else:
            yield path + (key,), value


def config_read(flags, cwd):
    def fixture(name, home=fixtures):
        path = home / name
        return json.loads(path.read_text()) if path.exists() else {}

    def origin(kind):
        return {"name": {"type": kind}, "version": "sha256:fixture"}

    aliases = fixture("fixture-aliases.json")
    # A fixture in the requested directory stands for that repository's own configuration.
    layers = dict(fixture("fixture-origins.json"), **fixture("fixture-origins.json", Path(cwd)))
    origins = {path: origin(kind) for path, kind in layers.items()}
    # Codex reports an unset value or table as null.
    config = dict({"model": None, "agents": None, "tui": None}, **fixture("fixture-config.json"))
    for path, value in leaves(flags):
        name = ".".join(path)
        if name in aliases:
            name = aliases[name]
            path = name.split(".")
        put(config, path, value)
        # Arrays are reported per element, so an empty array or table has no origin.
        if isinstance(value, list):
            keys = [name + "." + str(i) for i in range(len(value))]
        else:
            keys = [] if value == {} else [name]
        origins.update((key, origin("sessionFlags")) for key in keys)
    return {"config": config, "origins": origins}


def app_server():
    flags = session_flags(args[:-1])
    requests = directory / "fixture-requests"
    for line in sys.stdin:
        msg = json.loads(line)
        if msg["method"] == "initialized":
            continue
        # A test that creates this file learns which sessions started, and with which arguments.
        if requests.exists():
            with requests.open("a") as log:
                print(json.dumps([msg["method"], args[:-1]]), file=log)
        reply = {"id": msg["id"], "result": {}}
        if msg["method"] == "config/read":
            reply["result"] = config_read(flags, msg["params"]["cwd"])
            if (fixtures / "fixture-no-config-read").exists():
                reply = {"id": msg["id"], "error": {"code": -32601}}
        if msg["method"] == "hooks/list":
            cwd = msg["params"]["cwds"][0]
            hooks = []
            for guard in cache.glob("kk-guard/*"):
                trusted = directory / "fixture-reviewed"
                trust = ("untrusted" if not trusted.exists() else
                         "trusted" if trusted.read_text() == guard.name else "modified")
                groups = json.loads((guard / "hooks/hooks.json").read_text())["hooks"]["PreToolUse"]
                for i, group in enumerate(groups):
                    for j, hook in enumerate(group["hooks"]):
                        hooks.append(dict(hook, matcher=group["matcher"], source="plugin", pluginId="kk-guard@agentstakk-local",
                                          key="kk-guard@agentstakk-local:hooks/hooks.json:pre_tool_use:{}:{}".format(i, j),
                                          enabled=not (directory / ("disabled-" + str(i))).exists(), trustStatus=trust))
            features = flags.get("features")
            if (isinstance(features, dict) and features.get("hooks") is False
                    or (Path(cwd) / "fixture-guard-off").exists()):
                hooks = []
            reply["result"] = {"data": [{"cwd": cwd, "errors": [], "hooks": hooks}]}
            if (directory / "fixture-no-method").exists():
                reply = {"id": msg["id"], "error": {"code": -32601}}
        print(json.dumps(reply), flush=True)


if args[-1:] == ["app-server"]:
    app_server()
elif args[-2:] == ["exec", "wait-for-test-input"]:
    os.closerange(3, 256)
    print("running", flush=True)
    sys.exit(int(input()))
elif args[:3] == ["plugin", "marketplace", "list"]:
    print(json.dumps({"marketplaces": [{"name": "agentstakk-local", "root": market.read_text()}] if market.exists() else []}))
elif args[:3] == ["plugin", "marketplace", "add"]:
    directory.mkdir(parents=True, exist_ok=True)
    market.write_text(args[3])
    print("{}")
elif args[:3] == ["plugin", "marketplace", "remove"]:
    assert args[3] == "agentstakk-local"
    market.unlink()
    print("{}")
elif args[:2] == ["plugin", "list"]:
    path = directory / "codex-git"
    rows = installed() + (json.loads(path.read_text()) if path.is_file() else [])
    if "--marketplace" in args:
        marketplace = args[args.index("--marketplace") + 1]
        rows = [row for row in rows if row["pluginId"].endswith("@" + marketplace)]
    print(json.dumps({"installed": rows}))
elif args[:2] == ["plugin", "remove"]:
    if args[2] in ("kk@agentstakk-local", "kk-guard@agentstakk-local"):
        name = args[2].split("@")[0]
        shutil.rmtree(cache / name)
        if (directory / ("interrupt-remove-" + name)).exists():
            sys.exit(17)
    else:
        path = directory / "codex-git"
        rows = json.loads(path.read_text())
        path.write_text(json.dumps([p for p in rows if p["pluginId"] != args[2]]))
    print("{}")
elif args[:2] == ["plugin", "add"]:
    name = args[2].split("@")[0]
    root = Path(market.read_text())
    manifest = json.loads((root / ".agents/plugins/marketplace.json").read_text())
    source = root / next(p["source"]["path"] for p in manifest["plugins"] if p["name"] == name)
    version = json.loads((source / ".codex-plugin/plugin.json").read_text())["version"]
    destination = cache / name / version
    if destination.parent.exists():
        shutil.rmtree(destination.parent)
    shutil.copytree(source, destination, symlinks=True)
    with (directory / "fixture-adds").open("a") as log:
        print(name, version, file=log)
    if (directory / ("interrupt-add-" + name)).exists():
        sys.exit(17)
    print(json.dumps({"pluginId": args[2], "installedPath": str(destination), "version": version}))
elif args[-2:] == ["debug", "prompt-input"]:
    if (fixtures / "fixture-rejects-settings").exists():
        sys.exit("error: invalid configuration")
    print("[]")
elif args[:2] == ["execpolicy", "check"]:
    # Exercise kk's publication flow on CI without Codex. The live CLI test
    # independently verifies the generated rules, failure controls and syntax.
    program = args[args.index("--") + 1]
    print(json.dumps({"decision": "forbidden" if program in ("rm", "shred", "sudo", "su", "doas") else "allow"}))
else:
    print(json.dumps(args))
