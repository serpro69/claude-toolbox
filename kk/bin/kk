#!/usr/bin/env bash
set -euo pipefail

root=${KK_HOME:-${XDG_DATA_HOME:-"$HOME/.local/share"}/kk}
if [[ -z ${KK_HOME:-} ]]; then
    location=$(python3 -I -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "${BASH_SOURCE[0]}")
    installed=${location%/bin/kk}
    if [[ -f "$installed/state.json" ]]; then
        root=$installed
    elif [[ "$installed" == */releases/*/kk && -f "${installed%/releases/*}/state.json" ]]; then
        root=${installed%/releases/*}
    fi
fi
export KK_HOME="$root"
state=$root/state.json
if [[ -f "$state" ]]; then
    version=$(jq -er --arg command "${1:-}" '
        if .format_version != 1 then error("unsupported kk state format")
        elif $command == "rollback" then
            if .candidate.phase == "activating" then .active else .rollback_target end
        else .active // .candidate.version end
        | if type == "string" and test("^(v[0-9][0-9A-Za-z.+-]*|local-[a-f0-9]{32})$") then .
          else error("no release available for this command") end
    ' "$state")
    release=$root/releases/$version
    if [[ ! -d "$release" && -d "$root/staging/$version" ]]; then
        release=$root/staging/$version
    fi
    exec python3 -I -B "$release/kk/lib/run.py" "$@"
fi

# Also usable from a checkout (before the stable entry point is installed).
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
exec python3 -I -B "$here/lib/run.py" "$@"
